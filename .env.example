# Copy this file to .env and fill in what you need.
# The app runs fully offline / with zero keys using safe fallbacks --
# these are all optional upgrades.

# --- LLM (optional) ---------------------------------------------------
# Without this, /api/ask uses a deterministic, fully-cited extractive
# answer instead of calling an LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- Retrieval backends -------------------------------------------------
# "sbert" downloads a small sentence-transformers model on first run
# (needs internet once). Falls back to "tfidf" automatically if that
# fails, or set it explicitly for a fully offline demo.
EMBEDDING_BACKEND=sbert
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# "cross_encoder" downloads a small cross-encoder model on first run.
# Falls back to a lexical-overlap reranker automatically if that fails.
RERANK_BACKEND=cross_encoder
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Server ---------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false

# --- Citation enforcement -------------------------------------------------
MIN_CITED_SENTENCE_RATIO=0.6
